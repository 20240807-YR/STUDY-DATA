    "from pathlib import Path\n",
    "import pickle\n",
    "\n",
    "PKL_PATH = Path.cwd() / \"data\" / \"tone_vectors.pkl\"\n",
    "\n",
    "print(\"exists:\", PKL_PATH.exists())\n",
    "print(PKL_PATH)\n",
    "\n",
    "with open(PKL_PATH, \"rb\") as f:\n",
    "    tone = pickle.load(f)\n",
    "\n",
    "type(tone)\n",
    "list(tone.keys())[:5]\n",
    "tone[list(tone.keys())[0]]"
